# Copy to .env and fill in. Never commit .env.

# --- transport ---------------------------------------------------------------
# URL of the nodalytics/metatrader-terminal API (container/service name).
ORB_API_BASE_URL=http://mt5-terminal:8000

# Auth: provide EITHER a ready API key, OR the seed used at login.
ORB_API_KEY=
ORB_API_SEED=

# --- optional ----------------------------------------------------------------
# Override the config file location (default: ./config.json).
ORB_CONFIG=
# Directory for runtime artifacts (trades.csv, bot.log). Container default /app/data.
ORB_DATA_DIR=/app/data

# Optional webhook alerts (Discord/Slack JSON). See config alerts.enabled.
ORB_WEBHOOK_URL=

# Docker network name shared with the mt5-terminal container.
MT5_NETWORK=mt5net
